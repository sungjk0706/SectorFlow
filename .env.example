# SectorFlow - 설정 (backend/engine)
# 이 파일을 복사하여 .env 를 만들고 설정값을 입력하세요:
#   copy .env.example .env

# ── 암호화 키 (중요) ──────────────────────────────────
# DB에 저장된 증권사 API 키 등 민감정보 암호화에 사용.
# stocks.db 를 공유받은 경우, 원본 제공자의 ENCRYPTION_KEY 와
# 반드시 동일한 값을 사용해야 기존 설정이 복호화됩니다.
# 새로 설치하는 경우 아래 명령으로 새 키를 생성하세요:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 엔진·웹소켓 디버그: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# ── LS증권 OPEN API ───────────────────────────────────
# LS 증권사 사용 시 본인의 API 키 입력 (https://openapi.ls-sec.co.kr)
LS_APP_KEY=
LS_APP_SECRET=
LS_REST_BASE_URL=https://openapi.ls-sec.co.kr:8080

# ── 키움증권 API (선택) ────────────────────────────────
# 키움 증권사 사용 시 본인의 API 키 입력 (https://api.kiwoom.com)
# KIWOOM_APP_KEY=
# KIWOOM_APP_SECRET=
