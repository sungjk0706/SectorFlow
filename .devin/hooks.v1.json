{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": ".devin/scripts/session-bootstrap.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": ".devin/scripts/continuity-loop.sh",
          "timeout": 30
        }
      ]
    }
  ]
}
