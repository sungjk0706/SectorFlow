{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": ".devin/scripts/session-bootstrap.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": ".devin/scripts/continuity-loop.sh",
          "timeout": 30
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": ".devin/scripts/investigation-gate-prompt.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": ".devin/scripts/pretooluse-gate.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "bash scripts/pre-complete-check.sh auto; if [ $? -ne 0 ]; then echo '{\"decision\": \"block\", \"reason\": \"완료 전 기계적 검증 실패 — 실패 항목 수정 후 재시도. 스크립트 출력을 확인하세요.\"}'; fi",
          "timeout": 600
        }
      ]
    }
  ]
}
